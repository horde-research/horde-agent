# ══════════════════════════════════════════════════════════════════════
# Horde Agent — Pipeline Configuration
# ══════════════════════════════════════════════════════════════════════
# Copy to .env and fill in. Run with: python -m agent.main

# ── Pipeline ──────────────────────────────────────────────────────────
# Country/culture for taxonomy generation.
COUNTRY=Kazakhstan

# Directory where all outputs are saved (taxonomy, data, SFT, adapters, reports).
RUN_DIR=output/run

# Existing full_agentic run directories contain agent_state.json and resume by default.
# For non-interactive CLI reuse of completed stages, pass --resume-confirm-completed
# or set RESUME_CONFIRM_COMPLETED=true. If changing query/data knobs, prefer a new
# RUN_DIR or reset affected stages with --restart-from-stage generate_taxonomy.
# RESUME_CONFIRM_COMPLETED=false
# RESTART_FROM_STAGE=
# FRESH_RUN=false

# Resume from an existing SFT JSONL (train → eval → report only; skips taxonomy, collect, annotate):
#   python -m agent.main --mode workflow --data_path /abs/path/to/run/sft/sft.jsonl --out_dir /abs/path/to/run
# Use the same --out_dir as the original run so artifacts stay together.

# ── LLM Client ────────────────────────────────────────────────────────
# Used by ALL LLM calls: taxonomy, SFT annotation, agentic decisions.
LLM_PROVIDER=gemini
LLM_MODEL=gemini-2.5-flash
LLM_API_KEY=your-llm-api-key-here
# LLM_TEMPERATURE=0.7

# ── LangSmith Observability ───────────────────────────────────────────
# Required for agent run traces and per-stage spans in LangSmith.
LANGSMITH_API_KEY=lsv2_xxxxxxxxxxxxxxxxxxxx
# LANGSMITH_PROJECT=horde-agent

# ── Data Collection (Serper) ──────────────────────────────────────────
SERPER_API_KEY=your-serper-api-key-here
# How many Google results per query (before filtering). Default: 10
# SERPER_RESULTS_PER_QUERY=10
# How many top pages to scrape per query. Default: 5
# SERPER_TOP_RESULTS=5
# Limit total search queries sent to Serper. Useful for testing — e.g. set to 10
# to only search 10 queries instead of all 500+ from taxonomy. Empty = use all.
# MAX_QUERIES=10
# Optional balanced sampler before the global cap. Example: 10 selected queries
# per top-level taxonomy category, then MAX_QUERIES can still cap the total.
# MAX_QUERIES_PER_CATEGORY=10

# Also fetch images. Disabled by default. When enabled, the default collector
# uses Serper Google Images and downloads usable images under <run_dir>/images/.
# COLLECT_IMAGES=false
# Image collector mode: serper (default) or html (legacy scraped-page <img> parser).
# IMAGE_COLLECTION_MODE=serper
# Number of Google Images results requested per query when IMAGE_COLLECTION_MODE=serper.
# IMAGE_SEARCH_RESULTS_PER_QUERY=10
# Generate a language-agnostic visual taxonomy for image collection slots.
# ENABLE_IMAGE_TAXONOMY=true
# Number of image search queries generated for each visual taxonomy slot.
# IMAGE_TAXONOMY_QUERIES_PER_SLOT=4
# Optional slot cap for quick tests. Empty = all slots.
# IMAGE_TAXONOMY_MAX_SLOTS=5
# Minimum image dimensions in pixels (smaller images are skipped).
# IMAGE_MIN_WIDTH=300
# IMAGE_MIN_HEIGHT=300
# Characters of surrounding text saved for legacy html image collection.
# IMAGE_CONTEXT_SIZE=500

# ── Agentic Coverage Assessment ──────────────────────────────────────
# After collection, the agent inspects text/image coverage before SFT generation.
# If coverage is weak, it can route back to collection with refined queries.
# COVERAGE_MIN_TEXT_SAMPLES=3
# COVERAGE_MIN_SAMPLES_PER_QUERY=0.0
# COVERAGE_MAX_ADDED_QUERIES=12
# COVERAGE_MIN_IMAGE_SLOT_RATIO=0.2
# COVERAGE_MIN_IMAGES_PER_SLOT=1
# COVERAGE_MAX_IMAGE_QUERY_SPECS=12

# ── SFT Annotation ───────────────────────────────────────────────────
# Select which collected modality is converted into SFT examples and sent to training.
# TRAINING_MODALITY=text uses AutoModelForCausalLM + static_sft_default.
# TRAINING_MODALITY=image uses AutoModelForImageTextToText + vision_language_sft.
# For image training, HF_MODEL_ID must be an image-text model, not a text-only LM.
# Image eval uses the same image-text model family and validation SFT rows with image paths.
# Legacy alias: SFT_MODE=text|image.
# TRAINING_MODALITY=text
# Language for ALL generated training examples (questions + answers).
# REQUIRED — no default. Examples: English, Russian, Kazakh, Chinese
SFT_TARGET_LANGUAGE=English
# Bounded SFT prompt preset selected by config/recovery policy: default, schema_strict,
# culture_grounded for text, or ocr_heavy for image.
# SFT_PROMPT_PRESET=default

# ── Model & Training ─────────────────────────────────────────────────
# Base model from HuggingFace to fine-tune with LoRA.
# This is the model that gets downloaded and trained on your data.
HF_MODEL_ID=Qwen/Qwen2.5-1.5B

# Max gradient update steps per training iteration. More steps = longer
# training = potentially better. 200 is reasonable; 10-20 for quick tests.
# MAX_STEPS=200

# Max training iterations. In agentic mode, the agent can retry with
# adjusted hyperparameters up to this many times.
# MAX_ITERS=1

# Limit dataset to first N samples. Leave empty to use all data.
# MAX_SAMPLES=

# Fraction of built SFT examples held out under the validation split.
# Evaluation uses this split by default. Default: 0.1
# DATASET_VAL_RATIO=0.1

# Training batch size (per device). Default: 4
# TRAIN_BATCH_SIZE=4

# Max sequence length in tokens. Longer = more context but more memory. Default: 512
# TRAIN_MAX_SEQ_LEN=512

# Random hyperparameter search trials before the main training. 0 = skip.
# SEARCH_TRIALS=0

# ── Evaluation ────────────────────────────────────────────────────────
# Dataset split used by EvalModelTool. Default: validation
# EVAL_SPLIT=validation
# How many samples to evaluate on after training. Default: 64
# EVAL_MAX_SAMPLES=64
# Optional LLM-as-judge validation quality gate. Deterministic eval and
# train-health checks always run; the judge adds semantic quality labels.
# EVAL_ENABLE_LLM_JUDGE=false
# EVAL_JUDGE_MAX_SAMPLES=32
# EVAL_JUDGE_BATCH_SIZE=3
# EVAL_JUDGE_BATCH_DELAY=1.0

# ── CPU-Safe Full-Agentic Debug Flow ─────────────────────────────────
# Runs real taxonomy → collection → SFT annotation → dataset build, then replaces
# GPU-heavy training/eval with deterministic filesystem stubs so report generation
# and LangSmith trajectory still exercise the full constrained graph.
# Example:
#   MODE=full_agentic
#   MAX_QUERIES=500
#   MAX_QUERIES_PER_CATEGORY=10
#   SERPER_RESULTS_PER_QUERY=10
#   SERPER_TOP_RESULTS=10
#   DEBUG_STUB_TRAIN=true
#   DEBUG_STUB_EVAL=true
# Optional: force eval to produce repairable failures for recovery testing.
# DEBUG_EVAL_FAILURE_RATE=0.0

# ── Hugging Face Hub ─────────────────────────────────────────────────
# API token from https://huggingface.co/settings/tokens (needs write access).
# Used for downloading models and optionally pushing datasets/adapters.
HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxx

# Repo names for auto-pushing after SFT build and after training.
# Leave empty to skip. Repos are created as private under your HF account.
# HF_DATASET_REPO=
# HF_ADAPTER_REPO=
